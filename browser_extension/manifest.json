{
  "manifest_version": 3,
  "name": "Raahi Browser Connector",
  "version": "1.0.0",
  "minimum_chrome_version": "96",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:49381/*",
    "https://eauctionsindia.com/*",
    "https://www.eauctionsindia.com/*"
  ],
  "action": {
    "default_title": "Connect Raahi"
  },
  "background": {
    "service_worker": "background.js"
  }
}